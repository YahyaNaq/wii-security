# Postgres connection string (Vercel Postgres, Neon, or any Postgres instance)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Resend API key for sending quote confirmation emails
RESEND_API_KEY="re_xxxxxxxx"

# Verified sender address for outgoing quote emails.
# Until wiisecurity.com is verified at resend.com/domains, use Resend's sandbox
# sender "onboarding@resend.dev" for testing -- note it can only deliver to the
# email address on your own Resend account, not arbitrary customer addresses.
QUOTE_EMAIL_FROM="quotes@wiisecurity.com"

# Verified sender address for outgoing booking accept/reject emails.
# Same domain-verification caveat as QUOTE_EMAIL_FROM applies.
BOOKING_EMAIL_FROM="bookings@wiisecurity.com"

# Secret key used to sign admin portal session cookies.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET="generate-a-32-byte-random-string"

# Optional: if set, only this email may log into /admin. All other AdminUser
# accounts are rejected at login and session verification, even with a valid
# password / existing session. Leave unset to allow any AdminUser row.
ALLOWED_ADMIN_EMAIL="you@wiisecurity.com"
