generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ServiceType {
  PHONE_POUCHES
  MONITORING
  PHOTOGRAPHY
  VIDEOGRAPHY
}

enum PricedServiceType {
  PHOTOGRAPHY
  VIDEOGRAPHY
}

enum BookingStatus {
  IN_REVIEW
  ACCEPTED
  REJECTED
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum SalaryStatus {
  PENDING
  RELEASED
}

// Guest-count-based pricing for Monitoring.
model MonitoringGuestTierPrice {
  id        String @id @default(cuid())
  slug      String @unique
  minGuests Int
  maxGuests Int
  price     Int

  @@map("GuestTierPrice")
}

// Guest-count-based pricing for Phone Pouches.
model PouchGuestTierPrice {
  id        String @id @default(cuid())
  slug      String @unique
  minGuests Int
  maxGuests Int
  price     Int
}

// Flat-price named options for Photography / Videography.
model ServiceOptionPrice {
  id          String            @id @default(cuid())
  serviceType PricedServiceType
  slug        String
  label       String
  price       Int

  @@unique([serviceType, slug])
}

model QuoteRequest {
  id               String   @id @default(cuid())
  name             String
  phone            String
  email            String
  hearAboutUs      String
  hearAboutUsOther String?
  totalAmount      Int
  createdAt        DateTime @default(now())

  events QuoteEvent[]
}

model QuoteEvent {
  id             String   @id @default(cuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  city           String
  date           DateTime
  femaleGuests   Int
  details        String?
  subtotal       Int

  services QuoteService[]
}

model QuoteService {
  id           String      @id @default(cuid())
  quoteEventId String
  quoteEvent   QuoteEvent  @relation(fields: [quoteEventId], references: [id], onDelete: Cascade)
  type         ServiceType
  tier         String
  price        Int
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Booking {
  id              String        @id @default(cuid())
  name            String
  phone           String
  email           String
  totalAmount     Int
  status          BookingStatus @default(IN_REVIEW)
  receiptFileName String
  receiptMimeType String
  receiptData     Bytes
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  events BookingEvent[]
}

model BookingEvent {
  id               String   @id @default(cuid())
  bookingId        String
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  city             String
  date             DateTime
  reportingTime    String
  venue            String
  eventType        String
  eventTypeOther   String?
  femaleGuests     Int
  guestService     String?
  photographyTier  String?
  videographyTier  String?

  staff EventAssignment[]
}

model Employee {
  id                     String           @id @default(cuid())
  name                   String
  phoneNumber            String
  email                  String
  jobTitleId             String
  jobTitle               JobTitle         @relation(fields: [jobTitleId], references: [id])
  cnic                   String           @unique
  address                String
  city                   String
  employmentStatus       EmploymentStatus @default(ACTIVE)
  emergencyContactName   String?
  emergencyContactNumber String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  eventAssignments EventAssignment[]
  salaryPeriods    EmployeeSalaryPeriod[]
  bankDetails      EmployeeBankDetails?
}

model EmployeeBankDetails {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  bankName      String
  accountTitle  String
  accountNumber String
}

model JobTitle {
  id     String @id @default(cuid())
  title  String @unique
  // Salary is per gig, not a monthly/annual figure.
  salary Int

  employees Employee[]
}

// Records which employees actually worked a booking's event, filled in by
// admins after the event date has passed. Editable afterwards since staff
// can be swapped (e.g. a replacement volunteer).
model EventAssignment {
  id             String       @id @default(cuid())
  bookingEventId String
  bookingEvent   BookingEvent @relation(fields: [bookingEventId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@unique([bookingEventId, employeeId])
}

// A month of salary for an employee, computed from their EventAssignments
// that month. Only written when released — a released row locks in the
// amount at that time so later staffing/rate edits don't drift it; a month
// with no row is implicitly pending and its amount is computed live.
model EmployeeSalaryPeriod {
  id         String       @id @default(cuid())
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year       Int
  month      Int
  status     SalaryStatus @default(RELEASED)
  amount     Int
  // Discretionary top-up folded into `amount` at release time; kept separately
  // too so the breakdown (base gigs pay vs. bonus) stays visible afterwards.
  bonus      Int          @default(0)
  releasedAt DateTime     @default(now())

  @@unique([employeeId, year, month])
}
